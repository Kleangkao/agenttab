{
  "name": "@agenttab/example-remote-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/main.ts",
    "stack": "tsx src/stack.ts",
    "start:stack": "node dist/stack.js",
    "adopt": "tsx src/adopt-demo.ts",
    "devnet": "tsx src/devnet.ts",
    "devnet:e2e": "tsx src/devnet-e2e.ts",
    "start": "node dist/main.js",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@agenttab/example-neutral-merchant": "workspace:*",
    "@agenttab/fetch": "workspace:*",
    "@agenttab/gateway": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@scure/base": "^1.2.6",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "2.21.0",
    "@x402/fetch": "2.21.0",
    "@x402/svm": "2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
