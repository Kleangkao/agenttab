# Public Demo Host — `pnpm demo:stack` shape for Railway/Fly.
# Build from repo root:
#   docker build -f Dockerfile.demo-stack -t agenttab-demo-stack .
#   docker run --rm -p 8787:8787 -e HOST=0.0.0.0 agenttab-demo-stack
# UI: http://127.0.0.1:8787/ui  (mock DFlow only; auto-reseeds Now cards)

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.16.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages packages
COPY apps/gateway apps/gateway
COPY examples examples
COPY scripts scripts
COPY tools tools

RUN pnpm install --frozen-lockfile --filter @agenttab/example-remote-agent... \
  && pnpm --filter @agenttab/example-remote-agent... build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8787
ENV MERCHANT_PORT=8791
ENV AGENTTAB_DB_PATH=/data/stack-gateway.sqlite
ENV AGENTTAB_FUNDING_MODE=mock
ENV AGENTTAB_STACK_RESEED_MS=15000
ENV AGENTTAB_INITIAL_USDC_ATOMIC=0
ENV AGENTTAB_INITIAL_SOL_ATOMIC=5000000000

RUN mkdir -p /data /policy

COPY --from=build /app /app
COPY examples/policies/approve.local.json /policy/approve.local.json

ENV AGENTTAB_POLICY_PATH=/policy/approve.local.json

EXPOSE 8787

WORKDIR /app/examples/remote-agent

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Merchant listens on loopback :8791 inside the container; only PORT is public.
CMD ["node", "dist/stack.js"]
