# Copy to .env locally. The gateway does not load dotenv — export these
# in the shell or your process manager. Never commit real secrets.

# Bind address (read as PORT / HOST, not AGENTTAB_PORT)
PORT=8787
HOST=127.0.0.1
# Docker / containers: use HOST=0.0.0.0 (image default) so the port is reachable.

# Durable SQLite (policy + spend + audit). Default if unset.
AGENTTAB_DB_PATH=.data/gateway.sqlite

# Seed policy on first boot. Later boots keep SQLite unless AGENTTAB_POLICY_REPLACE=1
# AGENTTAB_POLICY_PATH=examples/policies/approve.local.json
# AGENTTAB_POLICY_REPLACE=1

# Merchant origin used when the policy file has none / for demo seed
# MERCHANT_ORIGIN=http://127.0.0.1:8791

# Shared with examples/paid-api. Either name works.
PAYMENT_HMAC_SECRET=local-dev-only-change-me
# AGENTTAB_PAYMENT_HMAC_SECRET=local-dev-only-change-me

# Optional: gate operator reads/writes (policy, spend, lists, approve, deny)
# AGENTTAB_ADMIN_TOKEN=
# Optional: gate agent spend paths (preview, fund, pay, fulfill). Admin bearer also works.
# AGENTTAB_AGENT_TOKEN=
# Optional name for that single token (default: agent)
# AGENTTAB_AGENT_ID=agent
# Optional extra named agent secrets: JSON object { "research": "secret", "ops": "secret2" }
# AGENTTAB_AGENT_TOKENS=

# Park / approve / deny webhook (fail-open). Optional HMAC:
# AGENTTAB_NOTIFY_URL=http://127.0.0.1:8792/hook
# AGENTTAB_NOTIFY_SECRET=
# Then: pnpm notify:sink
# Defaults (300ms budget / 200ms per attempt) assume a local receiver.
# A remote webhook over TLS usually needs more; invalid values fall back.
# AGENTTAB_NOTIFY_BUDGET_MS=300
# AGENTTAB_NOTIFY_ATTEMPT_TIMEOUT_MS=200

# Funding mode:
#   mock       - deterministic in-process quotes (default, offline)
#   live-quote - real DFlow developer quotes, no userPublicKey, no broadcast
#   live-sim   - real DFlow order with userPublicKey + simulateTransaction, never send
#   devnet-mint - only via the gateway-devnet entry / examples (injected adapter)
AGENTTAB_FUNDING_MODE=mock

# Defaults to https://dev-quote-api.dflow.net in live-quote / live-sim (no key required).
# DFLOW_BASE_URL=https://dev-quote-api.dflow.net
# Production quote-api.dflow.net requires a key; never paste it into chat.
# DFLOW_API_KEY=

# Mainnet RPC for live-sim simulateTransaction only (never broadcast).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Mock starting balances
# AGENTTAB_INITIAL_USDC_ATOMIC=0
# AGENTTAB_INITIAL_SOL_ATOMIC=5000000000
