# Optional root-level secrets template. The repo does not load dotenv.
# Export variables in the shell. Never commit real keys.

# live-quote / live-sim use the developer endpoint without a key by default.
DFLOW_BASE_URL=https://dev-quote-api.dflow.net
DFLOW_API_KEY=

# Devnet agent demos; live-sim uses mainnet RPC for simulate only.
SOLANA_RPC_URL=https://api.devnet.solana.com
AGENTTAB_FUNDING_MODE=mock

# Gateway process (see apps/gateway/.env.example for the full list)
# PORT=8787
# HOST=127.0.0.1
# AGENTTAB_DB_PATH=.data/gateway.sqlite
# AGENTTAB_POLICY_PATH=examples/policies/approve.local.json
# AGENTTAB_GATEWAY_URL=http://127.0.0.1:8787
# MERCHANT_ORIGIN=http://127.0.0.1:8791
# PAYMENT_HMAC_SECRET=local-dev-only-change-me

# Opt-in live DFlow / RPC tests (skipped in CI)
# AGENTTAB_NETWORK_TESTS=1
