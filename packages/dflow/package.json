{
  "name": "@agenttab/dflow",
  "version": "0.1.0",
  "description": "DFlow quote client and exact-deficit planner for AgentTab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kleangkao/agenttab.git",
    "directory": "packages/dflow"
  },
  "homepage": "https://github.com/Kleangkao/agenttab/tree/main/packages/dflow",
  "bugs": {
    "url": "https://github.com/Kleangkao/agenttab/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node ../../scripts/clean-dist.mjs",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}

